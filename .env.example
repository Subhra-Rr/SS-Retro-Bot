# ====================================================================
# SS RETRO BOT — ENVIRONMENT CONFIGURATION
# ====================================================================

# --- Telegram Bot Configuration ---
# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=SSRetroBot
# Comma-separated list of Telegram user IDs with administrative privileges
ADMIN_USER_IDS=

# --- Storage & Paths ---
DATABASE_PATH=data/bot.db
TEMP_DOWNLOAD_DIR=data/temp_downloads
LOG_LEVEL=INFO

# --- Limits & Timeouts ---
# Telegram bot standard sendAudio limit is 50MB. Set to 49MB for safety headroom.
MAX_FILE_SIZE_MB=49
DEFAULT_RESULTS_PER_PAGE=5
SEARCH_TIMEOUT_SECONDS=7.0
DOWNLOAD_TIMEOUT_SECONDS=60.0
CACHE_TTL_HOURS=24

# --- Music Provider Credentials ---
# 1. Jamendo API (CC-licensed & independent full-track catalog)
# Free registration at https://developer.jamendo.com
JAMENDO_CLIENT_ID=

# 2. Internet Archive (Archive.org - public domain, live recordings, vintage Indian/regional/classical)
# No authentication required for open access collections

# 3. iTunes Search API (Apple metadata discovery)
# Public search API requires no credentials

# 4. Spotify Web API (Optional metadata discovery)
# Register at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 5. MusicBrainz API (Open music encyclopedia metadata)
# No API key required; requires compliant User-Agent
MUSICBRAINZ_APP_NAME=SSRetroBot/1.0.0
MUSICBRAINZ_CONTACT=https://t.me/SSRetroBot

# 6. MassiveMusic / 7digital B2B API (Commercial partner catalog)
# Commercial application required at https://developer.7digital.com
MASSIVEMUSIC_API_KEY=
MASSIVEMUSIC_API_SECRET=
